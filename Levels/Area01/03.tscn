[node name="DialogText" type="Node" parent="NPC2/DialogInteraction/DialogChoice/DialogBranch"]
script = ExtResource("11_q54cq")
text = "Thank you dear hero! You are a true specimen!"
npc_info = ExtResource("13_n7k4n")
