[node name="DialogInteraction" parent="NPC" instance=ExtResource("11_a0g71")]

[node name="DialogText" type="Node" parent="NPC/DialogInteraction"]
script = ExtResource("12_n3la7")
text = "I can't believe it... the [color=#7A3E9D]dark aura[/color] is [shake]gone![/shake]"
npc_info = SubResource("Resource_2l6ck")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText2" type="Node" parent="NPC/DialogInteraction"]
script = ExtResource("12_n3la7")
text = "You are a [color=#FFD700]true hero[/color]! My garden is finally [color=#4CAF50]safe[/color] from those monsters."
npc_info = SubResource("Resource_rbd2o")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="NPC2" parent="." instance=ExtResource("6_fsuok")]
position = Vector2(428, 107)
npc_resource = SubResource("Resource_suexf")

[node name="NpcWanderBehavior" parent="NPC2" instance=ExtResource("10_dve0t")]

[node name="DialogInteraction" parent="NPC2" instance=ExtResource("11_a0g71")]

[node name="DialogText" type="Node" parent="NPC2/DialogInteraction"]
script = ExtResource("12_n3la7")
text = "[shake]Wow![/shake] You actually defeated the [color=#FF4500]Goblin Warlord[/color]?!"
npc_info = SubResource("Resource_t4onu")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText2" type="Node" parent="NPC2/DialogInteraction"]
script = ExtResource("12_n3la7")
text = "I always knew you could do it... [wave]well, mostly![/wave]"
npc_info = SubResource("Resource_ao3f7")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText3" type="Node" parent="NPC2/DialogInteraction"]
script = ExtResource("12_n3la7")
text = "We will never forget your [color=#FFD700]courage[/color]! You're a [wave]legend[/wave] now!"
npc_info = SubResource("Resource_t1cxi")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="NPC5" parent="." instance=ExtResource("6_fsuok")]
position = Vector2(270, 192)
npc_resource = ExtResource("13_u38tu")

[node name="DialogInteraction" parent="NPC5" instance=ExtResource("11_a0g71")]

[node name="DialogText" type="Node" parent="NPC5/DialogInteraction"]
script = ExtResource("12_n3la7")
text = "Ah... you have [wave]returned victorious[/wave]."
npc_info = ExtResource("13_u38tu")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText2" type="Node" parent="NPC5/DialogInteraction"]
script = ExtResource("12_n3la7")
text = "The [color=#7A3E9D]dark aura[/color] from the dungeon has finally lifted. The village is [color=#4CAF50]safe[/color]."
npc_info = ExtResource("13_u38tu")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText3" type="Node" parent="NPC5/DialogInteraction"]
script = ExtResource("12_n3la7")
text = "Thank you, [color=#FFD700]brave hero[/color]. Now, we can finally live in [wave]peace[/wave]."
npc_info = ExtResource("13_u38tu")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

