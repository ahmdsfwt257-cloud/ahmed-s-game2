[node name="DialogText" type="Node" parent="NPC/DialogInteraction" unique_id=756067821]
script = ExtResource("12_n3la7")
text = "I can't believe it... the [color=#7A3E9D]dark aura[/color] is [shake]gone![/shake]"
npc_info = SubResource("Resource_2l6ck")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText2" type="Node" parent="NPC/DialogInteraction" unique_id=1608750438]
script = ExtResource("12_n3la7")
text = "You are a [color=#FFD700]true hero[/color]! My garden is finally [color=#4CAF50]safe[/color] from those monsters."
npc_info = SubResource("Resource_rbd2o")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="NPC2" parent="." unique_id=1162967857 instance=ExtResource("6_fsuok")]
position = Vector2(441, 76)
