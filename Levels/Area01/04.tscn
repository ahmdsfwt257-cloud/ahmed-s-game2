[node name="DialogInteraction" parent="NPC" unique_id=977541734 instance=ExtResource("9_ikg4w")]

[node name="DialogText" type="Node" parent="NPC/DialogInteraction" unique_id=1839354457]
script = ExtResource("10_h7p5o")
text = "You made it this far."
npc_info = ExtResource("8_7src1")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText2" type="Node" parent="NPC/DialogInteraction" unique_id=516522357]
script = ExtResource("10_h7p5o")
text = "That entrance leads to the dungeon."
npc_info = ExtResource("8_7src1")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText3" type="Node" parent="NPC/DialogInteraction" unique_id=2089119612]
script = ExtResource("10_h7p5o")
text = "No one has returned from it in years."
npc_info = ExtResource("8_7src1")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogChoice" type="Node" parent="NPC/DialogInteraction" unique_id=1987651850]
script = ExtResource("11_kwybj")
npc_info = ExtResource("8_7src1")
metadata/_custom_type_script = "uid://bdi8bnthvpfy5"

[node name="DialogBranch" type="Node" parent="NPC/DialogInteraction/DialogChoice" unique_id=1489194532]
script = ExtResource("12_bm8hg")
text = "I'm going in."
npc_info = ExtResource("13_6yofg")
metadata/_custom_type_script = "uid://bvrnk7am5wsx4"

[node name="DialogText" type="Node" parent="NPC/DialogInteraction/DialogChoice/DialogBranch" unique_id=1322204218]
script = ExtResource("10_h7p5o")
text = "Then go. The village is counting on you."
npc_info = ExtResource("8_7src1")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText2" type="Node" parent="NPC/DialogInteraction/DialogChoice/DialogBranch" unique_id=862128173]
script = ExtResource("10_h7p5o")
text = "Don't come back without finishing this."
npc_info = ExtResource("8_7src1")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogBranch2" type="Node" parent="NPC/DialogInteraction/DialogChoice" unique_id=270354221]
script = ExtResource("12_bm8hg")
text = "What's inside?"
npc_info = ExtResource("8_7src1")
metadata/_custom_type_script = "uid://bvrnk7am5wsx4"

[node name="DialogText" type="Node" parent="NPC/DialogInteraction/DialogChoice/DialogBranch2" unique_id=1757995745]
script = ExtResource("10_h7p5o")
text = "Goblins. And the wizard Nero spoke of."
npc_info = ExtResource("8_7src1")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText2" type="Node" parent="NPC/DialogInteraction/DialogChoice/DialogBranch2" unique_id=275746589]
script = ExtResource("10_h7p5o")
text = "He is the one who opened this dungeon."
npc_info = ExtResource("8_7src1")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText3" type="Node" parent="NPC/DialogInteraction/DialogChoice/DialogBranch2" unique_id=2093882862]
script = ExtResource("10_h7p5o")
text = "Stop him... and the monsters stop too."
npc_info = ExtResource("8_7src1")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

