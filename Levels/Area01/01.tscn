[node name="NPC" parent="." unique_id=1045899000 instance=ExtResource("6_b60gt")]
position = Vector2(131, 63)
npc_resource = SubResource("Resource_vg1n0")

[node name="NpcWanderBehavior" parent="NPC" unique_id=1958834417 instance=ExtResource("8_an23e")]
wander_range = 5

[node name="DialogInteraction" parent="NPC" unique_id=196512320 instance=ExtResource("9_an23e")]

[node name="DialogText" type="Node" parent="NPC/DialogInteraction" unique_id=774524580]
script = ExtResource("10_c2gse")
text = "Those slimes are getting too close to my garden!"
npc_info = SubResource("Resource_2l6ck")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText2" type="Node" parent="NPC/DialogInteraction" unique_id=713975893]
script = ExtResource("10_c2gse")
text = "Open those tressure chests if you need supplies. Good Luck!"
npc_info = SubResource("Resource_rbd2o")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="NPC2" parent="." unique_id=671075394 instance=ExtResource("6_b60gt")]
position = Vector2(428, 107)
npc_resource = SubResource("Resource_suexf")

[node name="NpcWanderBehavior" parent="NPC2" unique_id=83578605 instance=ExtResource("8_an23e")]

[node name="DialogInteraction" parent="NPC2" unique_id=1559733495 instance=ExtResource("9_an23e")]

[node name="DialogText" type="Node" parent="NPC2/DialogInteraction" unique_id=332651098]
script = ExtResource("10_c2gse")
text = "Hey! Did you see those slimes out there? Crazy, right?"
npc_info = SubResource("Resource_t4onu")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText2" type="Node" parent="NPC2/DialogInteraction" unique_id=1730944211]
script = ExtResource("10_c2gse")
text = "Elder Oren told us to stay inside... but I'm not scared!"
npc_info = SubResource("Resource_ao3f7")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText3" type="Node" parent="NPC2/DialogInteraction" unique_id=2130200822]
script = ExtResource("10_c2gse")
text = "If you can stop them, I'll owe you big time!"
npc_info = SubResource("Resource_t1cxi")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="NPC5" parent="." unique_id=2050183005 instance=ExtResource("6_b60gt")]
position = Vector2(270, 192)
npc_resource = ExtResource("9_c2gse")

[node name="DialogInteraction" parent="NPC5" unique_id=150437723 instance=ExtResource("9_an23e")]

[node name="DialogText" type="Node" parent="NPC5/DialogInteraction" unique_id=516103992]
script = ExtResource("10_c2gse")
text = "Ah... you're finally awake."
npc_info = ExtResource("9_c2gse")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText2" type="Node" parent="NPC5/DialogInteraction" unique_id=417544843]
script = ExtResource("10_c2gse")
text = "The village is in danger. Strange creatures have been appearing from the southern forest."
npc_info = ExtResource("9_c2gse")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText3" type="Node" parent="NPC5/DialogInteraction" unique_id=755698866]
script = ExtResource("10_c2gse")
text = "Slimes at first... but I fear something worse is coming."
npc_info = ExtResource("9_c2gse")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogChoice" type="Node" parent="NPC5/DialogInteraction" unique_id=254050810]
script = ExtResource("15_suexf")
npc_info = ExtResource("9_c2gse")
metadata/_custom_type_script = "uid://bdi8bnthvpfy5"

[node name="DialogBranch" type="Node" parent="NPC5/DialogInteraction/DialogChoice" unique_id=2056300621]
script = ExtResource("16_ao3f7")
text = "What's happening?"
npc_info = ExtResource("17_t1cxi")
metadata/_custom_type_script = "uid://bvrnk7am5wsx4"

[node name="DialogText" type="Node" parent="NPC5/DialogInteraction/DialogChoice/DialogBranch" unique_id=47797896]
script = ExtResource("10_c2gse")
text = "There is an old dungeon south of the plains. It has been sealed for generations."
npc_info = ExtResource("9_c2gse")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText2" type="Node" parent="NPC5/DialogInteraction/DialogChoice/DialogBranch" unique_id=1615276500]
script = ExtResource("10_c2gse")
text = "Someone — or something — has opened it. The monsters come from inside."
npc_info = ExtResource("9_c2gse")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText3" type="Node" parent="NPC5/DialogInteraction/DialogChoice/DialogBranch" unique_id=116092212]
script = ExtResource("10_c2gse")
text = "If we don't stop them... the village won't survive."
npc_info = ExtResource("9_c2gse")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogBranch2" type="Node" parent="NPC5/DialogInteraction/DialogChoice" unique_id=1788749989]
script = ExtResource("16_ao3f7")
text = "I'm ready."
npc_info = ExtResource("17_t1cxi")
metadata/_custom_type_script = "uid://bvrnk7am5wsx4"

[node name="DialogText" type="Node" parent="NPC5/DialogInteraction/DialogChoice/DialogBranch2" unique_id=302458886]
script = ExtResource("10_c2gse")
text = "Courage alone won't be enough, boy."
npc_info = ExtResource("9_c2gse")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText2" type="Node" parent="NPC5/DialogInteraction/DialogChoice/DialogBranch2" unique_id=991359980]
script = ExtResource("10_c2gse")
text = "Take your sword. Test yourself on the slimes south of the village first."
npc_info = ExtResource("9_c2gse")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

[node name="DialogText3" type="Node" parent="NPC5/DialogInteraction/DialogChoice/DialogBranch2" unique_id=255515713]
script = ExtResource("10_c2gse")
text = "Be careful out there."
npc_info = ExtResource("9_c2gse")
metadata/_custom_type_script = "uid://dpayt7gktjt8s"

